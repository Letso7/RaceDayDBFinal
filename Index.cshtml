@model List<RaceDay.MVC.Models.EventVM>
<div class="hero">
    <h1>Find Your Next <span class="volt">Race.</span></h1><p>Run, cycle, conquer. Pick an event and go.</p>
    <form method="get" class="d-flex gap-2"><input name="search" class="form-control" placeholder="🔍 Search events..." /><select name="eventType" class="form-control"><option value="">All Types</option><option value="run">Run</option><option value="cycle">Cycle</option><option value="swim">Swim</option></select><button class="btn btn-volt">Filter</button></form>
</div>
<div class="row">
    @foreach (var e in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                @if (!string.IsNullOrEmpty(e.ImageUrl))
                {
                    <img src="@e.ImageUrl" class="card-img-top" />
                }
                <div class="card-body">
                    <span class="badge bg-primary">@e.EventType</span><span class="badge bg-warning text-dark ms-1">@e.Distance km</span>
                    <h4 class="mt-2">@e.EventName</h4><p class="event-meta">📍 @e.Location • 📅 @e.EventDate.ToString("dd MMM yyyy")</p><p>@e.Description</p>
                    <a href="/Participant/Details/@e.EventId" class="btn-raceday w-100 text-center d-block text-decoration-none">View Event →</a>
                </div>
            </div>
        </div>
    }
</div>
@if (Model.Count == 0)
{
    <p class="text-center">No events found. Try another search.</p>
}
}
}